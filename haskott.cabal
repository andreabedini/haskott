cabal-version:   3.0
name:            haskott
version:         0.1.0.0
synopsis:        A Haskell reimplementation of Ott, with a language server
description:
    haskott reads Ott specifications (Sewell et al., JFP 2010) and writes what
    Ott writes: TeX, the @[[ ]]@ document filters, and Coq, Isabelle, HOL,
    Lem, OCaml and Twelf definitions, byte for byte on Ott's own tests and
    examples. It takes Ott's command line. Because it parses into a lossless
    syntax tree it also checks a whole specification with error recovery,
    renames a root across files and documents, writes Typst, and runs a
    language server. The source language is specified in
    <https://github.com/andreabedini/haskott/blob/main/GRAMMAR.md GRAMMAR.md>.
category:        Language
license:         BSD-3-Clause
license-file:    LICENSE
author:          Andrea Bedini
maintainer:      andrea@bedini.au
build-type:      Simple
tested-with:     GHC ==9.12.2
extra-doc-files:
    README.md
    GRAMMAR.md
extra-source-files:
    test/ott-acceptance.tsv
    test/first-diagnostics.tsv
    test/extensions/*.ott
    test/extensions/*.typ
    test/extensions/*.tex
    scripts/ott-acceptance.zsh

common warnings
    ghc-options: -Wall -Widentities -Wcompat -Wincomplete-uni-patterns

library
    import:           warnings
    hs-source-dirs:   src
    default-language: Haskell2010
    exposed-modules:
        Haskott
        Haskott.Defns
        Haskott.Diagnostics
        Haskott.Graph
        Haskott.Highlight
        Haskott.Load
        Haskott.Outline
        Haskott.Project
        Haskott.Prover
        Haskott.Prover.Bounds
        Haskott.Prover.Context
        Haskott.Prover.CoqInduct
        Haskott.Prover.Defns
        Haskott.Prover.Dependency
        Haskott.Prover.ExpandLists
        Haskott.Prover.LocallyNameless
        Haskott.Prover.Pp
        Haskott.Prover.Subrules
        Haskott.Prover.Substs
        Haskott.Prover.System
        Haskott.Prover.Transform
        Haskott.Prover.Types
        Haskott.Raw
        Haskott.Raw.Show
        Haskott.Rename
        Haskott.SourceLoc
        Haskott.Spec
        Haskott.Spec.Check
        Haskott.Spec.Show
        Haskott.Spec.Suffix
        Haskott.Syntax
        Haskott.Syntax.Ast
        Haskott.Syntax.Kind
        Haskott.Syntax.Parser
        Haskott.Term.Earley
        Haskott.Term.Grammar
        Haskott.Term.Merge
        Haskott.Term.Parse
        Haskott.Term.Requests
        Haskott.Term.Splice
        Haskott.Term.Symterm
        Haskott.Term.Tree
        Haskott.Tex
    build-depends:
        base         >=4.18 && <5,
        aeson        >=2.1  && <2.3,
        array        >=0.5  && <0.6,
        bytestring   >=0.11 && <0.13,
        containers   >=0.6  && <0.9,
        filepath     >=1.4  && <1.6,
        text         >=2.0  && <2.2,
        transformers >=0.5  && <0.7,
        graft        >=0.1  && <0.2

executable haskott
    import:           warnings
    hs-source-dirs:   app
    default-language: GHC2021
    main-is:          Main.hs
    other-modules:    Server
    ghc-options:      -threaded
    build-depends:
        base,
        bytestring,
        containers,
        deepseq,
        directory,
        filepath,
        graft,
        lens,
        lsp       >=2.7 && <2.9,
        lsp-types >=2.3 && <2.5,
        text,
        haskott

executable haskott-differential
    import:           warnings
    hs-source-dirs:   differential
    default-language: GHC2021
    main-is:          Main.hs
    build-depends:
        base,
        bytestring,
        containers,
        filepath,
        process,
        directory,
        text,
        haskott

test-suite corpus
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    default-language: GHC2021
    main-is:          Corpus.hs
    build-depends:
        base,
        bytestring,
        filepath,
        text,
        graft,
        haskott

test-suite rename-sweep
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    default-language: GHC2021
    main-is:          RenameSweep.hs
    ghc-options:      -threaded -rtsopts
    build-depends:
        base,
        bytestring,
        containers,
        filepath,
        text,
        haskott

test-suite recovery
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    default-language: GHC2021
    main-is:          Recovery.hs
    build-depends:
        base,
        bytestring,
        containers,
        filepath,
        text,
        graft,
        haskott

test-suite extensions
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    default-language: GHC2021
    main-is:          Extensions.hs
    build-tool-depends: haskott:haskott
    build-depends:
        base,
        bytestring,
        directory,
        filepath,
        process

test-suite lsp
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    default-language: GHC2021
    main-is:          Lsp.hs
    build-tool-depends: haskott:haskott
    build-depends:
        base,
        directory,
        filepath,
        lens,
        lsp-test  >=0.17 && <0.19,
        lsp-types,
        parser-combinators,
        temporary,
        text
