cabal-version:   3.0
name:            haskott
version:         0.1.0.0
synopsis:        A Haskell reimplementation of the Ott semantics tool
description:
    A reimplementation of Ott (Sewell et al., JFP 2010) in Haskell. Ott source
    files are parsed into a lossless concrete syntax tree (graft), checked, and
    typeset. See GRAMMAR.md for the specification of the Ott source language.
category:        Language
license:         BSD-3-Clause
author:          Andrea Bedini
maintainer:      andrea@bedini.au
build-type:      Simple
tested-with:     GHC ==9.12.2
extra-doc-files:
    README.md
    GRAMMAR.md
extra-source-files:
    test/ott-acceptance.tsv
    scripts/ott-acceptance.zsh

common warnings
    ghc-options: -Wall -Widentities -Wcompat -Wincomplete-uni-patterns

library
    import:           warnings
    hs-source-dirs:   src
    default-language: Haskell2010
    exposed-modules:
        Haskott
        Haskott.Defns
        Haskott.Load
        Haskott.Raw
        Haskott.Raw.Show
        Haskott.Rename
        Haskott.Spec
        Haskott.Spec.Check
        Haskott.Spec.Show
        Haskott.Spec.Suffix
        Haskott.Syntax
        Haskott.Syntax.Ast
        Haskott.Syntax.Kind
        Haskott.Syntax.Parser
        Haskott.Term.Earley
        Haskott.Term.Grammar
        Haskott.Term.Merge
        Haskott.Term.Parse
        Haskott.Term.Requests
        Haskott.Term.Splice
        Haskott.Term.Symterm
        Haskott.Term.Tree
        Haskott.Typst
    build-depends:
        base         >=4.18 && <5,
        array        >=0.5  && <0.6,
        bytestring   >=0.11 && <0.13,
        containers   >=0.6  && <0.9,
        text         >=2.0  && <2.2,
        transformers >=0.5  && <0.7,
        graft        >=0.1  && <0.2

executable haskott
    import:           warnings
    hs-source-dirs:   app
    default-language: GHC2021
    main-is:          Main.hs
    build-depends:
        base,
        bytestring,
        graft,
        text,
        haskott

executable haskott-differential
    import:           warnings
    hs-source-dirs:   differential
    default-language: GHC2021
    main-is:          Main.hs
    build-depends:
        base,
        bytestring,
        containers,
        filepath,
        process,
        directory,
        text,
        haskott

test-suite corpus
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    default-language: GHC2021
    main-is:          Corpus.hs
    build-depends:
        base,
        bytestring,
        filepath,
        text,
        haskott

test-suite rename-sweep
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    default-language: GHC2021
    main-is:          RenameSweep.hs
    ghc-options:      -threaded -rtsopts
    build-depends:
        base,
        bytestring,
        containers,
        filepath,
        text,
        haskott
