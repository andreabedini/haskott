#!/usr/bin/env zsh
# Regenerate test/ott-acceptance.tsv: what Ott does with every corpus file.
#
# Usage: scripts/ott-acceptance.zsh
# Run from the repository root. HASKOTT_OTT names the checkout of upstream
# Ott (its bin/ott is the Ott binary); it defaults to ../ott. The corpus is
# every .ott file under tests/ and examples/ of that checkout. Each line of
# the table is "class<TAB>path", where the path starts with ott/ and the
# class is one of accepted, other-error (Ott parsed the file and failed
# later) and parse-error (a syntax or lexing error in Ott's front end, or a
# rule annotation it could not parse).
set -e
ott_dir=${HASKOTT_OTT:-../ott}
ott=$ott_dir/bin/ott
out=test/ott-acceptance.tsv
tmp=$(mktemp)
classify() {
  local log
  log=$(timeout 120 "$ott" -i "$1" 2>&1 || true)
  if printf '%s' "$log" | rg -qi 'problem parsing|lexing error|bad annotation'; then
    printf 'parse-error'
  elif printf '%s' "$log" | rg -q 'Error'; then
    printf 'other-error'
  else
    printf 'accepted'
  fi
}
{
  printf '# Generated by scripts/ott-acceptance.zsh with: %s\n' "$("$ott" 2>&1 | head -1)"
  for f in "$ott_dir"/tests/*.ott "$ott_dir"/examples/**/*.ott; do
    printf '%s\tott/%s\n' "$(classify "$f")" "${f#$ott_dir/}"
  done
} > "$tmp"
mv "$tmp" "$out"
cut -f1 "$out" | rg -v '^#' | sort | uniq -c
